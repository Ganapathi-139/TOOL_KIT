# ==============================================================================
# ToolKit Environment Variables Configuration Template
# Copy this file to `.env.local` for local development or set in Vercel settings
# ==============================================================================

# [Optional] Secret salt used to sign & verify HMAC-SHA256 File Share QR tokens.
# If omitted, ToolKit automatically generates a secure persistent cryptographic
# signing key. For custom multi-instance deployments behind a load balancer,
# provide a persistent 64-character random string so all nodes share the same key.
# Example: Generate with `openssl rand -hex 32` or `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
FILE_SHARE_SECRET=your_persistent_64_character_hex_secret_here

# [Optional] Canonical public site URL used for mobile-scannable QR links and OpenGraph cards.
# Default: https://toolkit.sgscreations.in
NEXT_PUBLIC_SITE_URL=https://toolkit.sgscreations.in

# [Optional] Custom FormSubmit endpoint or target email for contact form submissions.
# Default: https://formsubmit.co/ajax/contact@sgscreations.in
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formsubmit.co/ajax/your_email@example.com

# [Optional] Custom path to Python executable for enhanced local PDF-to-Word conversions.
# Automatically detected from PATH if omitted.
# PYTHON_PATH=python
